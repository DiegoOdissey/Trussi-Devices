<?xml version="1.0" encoding="utf-8"?>
<Window
        x:Class="TrussiApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrussiApp">

        <Grid x:Name="RootGrid">
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270"/>
                        <!-- Sidebar -->
                        <ColumnDefinition Width="1"/>
                        <!-- Divider -->
                        <ColumnDefinition Width="*"/>
                        <!-- Dashboard -->
                        <ColumnDefinition Width="1"/>
                        <!-- Detail divider -->
                        <ColumnDefinition x:Name="DetailCol"
                                        Width="0"/>
                        <!-- Detail panel -->
                </Grid.ColumnDefinitions>

                <!-- ── Sidebar ── -->
                <Grid Grid.Column="0"
                                Background="#111111"
                                Padding="20,28,20,20">
                        <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Logo -->
                        <TextBlock Grid.Row="0"
                                   Text="TrussiApp"
                                   FontSize="32"
                                   Foreground="White"
                                   FontFamily="ms-appx:///Assets/chopsic.otf#Chopsic"/>

                        <!-- Nav -->
                        <StackPanel Grid.Row="2"
                                        Spacing="4">
                                <Button x:Name="NavDevices"
                                        Content="Devices"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="12,10"
                                        Background="#222222"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontSize="13"
                                        Click="NavDevices_Click"/>

                                <Button x:Name="NavSettings"
                                        Content="Settings"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="12,10"
                                        Background="Transparent"
                                        Foreground="#888888"
                                        BorderThickness="0"
                                        FontSize="13"
                                        Click="NavSettings_Click"/>
                        </StackPanel>

                        <!-- Bottom -->
                        <StackPanel Grid.Row="3"
                                        Spacing="12">
                                <Button Content="Check for updates"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="12,10"
                                        Background="Transparent"
                                        Foreground="#666666"
                                        BorderThickness="0"
                                        FontSize="12"
                                        Click="CheckUpdates_Click"/>

                                <TextBlock Text="TrussiApp v1.1.2"
                                           FontSize="11"
                                           Foreground="#444444"
                                           Padding="12,0"/>
                        </StackPanel>
                </Grid>

                <!-- ── Sidebar / content divider ── -->
                <Rectangle Grid.Column="1"
                                Fill="#222222"/>

                <!-- ── Dashboard frame ── -->
                <Frame x:Name="MainFrame"
                       Grid.Column="2"
                       Background="#161616"/>

                <!-- ── Detail divider (hidden until panel opens) ── -->
                <Rectangle x:Name="DetailDivider"
                           Grid.Column="3"
                           Fill="#222222"
                           Visibility="Collapsed"/>

                <!-- ── Detail panel ── -->
                <Frame x:Name="DetailFrame"
                       Grid.Column="4"
                       Background="#161616"/>

        </Grid>
</Window>