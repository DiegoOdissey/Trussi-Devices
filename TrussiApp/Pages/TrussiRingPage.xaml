<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TrussiApp.Pages.TrussiRingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Padding="32,28,32,28"
            RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Device layout -->
            <RowDefinition Height="240"/>
            <!-- Mapping panel -->
            <RowDefinition Height="Auto"/>
            <!-- Bottom buttons -->
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="←"
                    FontSize="16"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#888888"
                    Padding="0"
                    Click="BackButton_Click"/>

            <TextBlock Grid.Column="2"
                       Text="TrussiRing"
                       FontSize="20"
                    FontWeight="SemiBold"
                       Foreground="White"
                       VerticalAlignment="Center"/>

            <Border Grid.Column="3"
                    x:Name="StatusBadge"
                    CornerRadius="14"
                    Background="#2A1A1A"
                    Padding="10,4">
                <TextBlock x:Name="StatusBadgeText"
                           Text="Disconnesso"
                           FontSize="11"
                           Foreground="#CC3333"/>
            </Border>
        </Grid>

        <!-- ── Device layout — big knob left, 4 buttons right ── -->
        <Border Grid.Row="1"
                Background="#1A1A1A"
                CornerRadius="12"
                Padding="24,20"
                BorderBrush="#2A2A2A"
                BorderThickness="1">

            <Grid ColumnSpacing="32"
                    HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Knob -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Buttons -->
                </Grid.ColumnDefinitions>

                <!-- Big decorative knob — plain Border, not a Button.
                     No Click handler = not interactive by design. -->
                <Border Grid.Column="0"
                        Width="110"
                        Height="110"
                        CornerRadius="55"
                        Background="#252525"
                        BorderBrush="#3A3A3A"
                        BorderThickness="3"
                        VerticalAlignment="Center">
                    <TextBlock Text="RING"
                               FontSize="11"
                               Foreground="#555555"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- 4 editable square buttons, 2x2 -->
                <Grid Grid.Column="1"
                        RowSpacing="14"
                        ColumnSpacing="14"
                      VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="Key1"
                            Grid.Row="0"
                            Grid.Column="0"
                            Tag="KEY:0"
                            Width="52"
                            Height="52"
                            Background="#252525"
                            BorderBrush="#3A3A3A"
                            BorderThickness="2"
                            CornerRadius="8"
                            Padding="0"
                            Click="InputButton_Click">
                        <TextBlock Text="1"
                                FontSize="12"
                                Foreground="#666666"/>
                    </Button>

                    <Button x:Name="Key2"
                            Grid.Row="0"
                            Grid.Column="1"
                            Tag="KEY:1"
                            Width="52"
                            Height="52"
                            Background="#252525"
                            BorderBrush="#3A3A3A"
                            BorderThickness="2"
                            CornerRadius="8"
                            Padding="0"
                            Click="InputButton_Click">
                        <TextBlock Text="2"
                                FontSize="12"
                                Foreground="#666666"/>
                    </Button>

                    <Button x:Name="Key3"
                            Grid.Row="1"
                            Grid.Column="0"
                            Tag="KEY:2"
                            Width="52"
                            Height="52"
                            Background="#252525"
                            BorderBrush="#3A3A3A"
                            BorderThickness="2"
                            CornerRadius="8"
                            Padding="0"
                            Click="InputButton_Click">
                        <TextBlock Text="3"
                                FontSize="12"
                                Foreground="#666666"/>
                    </Button>

                    <Button x:Name="Key4"
                            Grid.Row="1"
                            Grid.Column="1"
                            Tag="KEY:3"
                            Width="52"
                            Height="52"
                            Background="#252525"
                            BorderBrush="#3A3A3A"
                            BorderThickness="2"
                            CornerRadius="8"
                            Padding="0"
                            Click="InputButton_Click">
                        <TextBlock Text="4"
                                FontSize="12"
                                Foreground="#666666"/>
                    </Button>
                </Grid>

            </Grid>
        </Border>

        <!-- ── Mapping panel ── -->
        <Border Grid.Row="2"
                Background="#1A1A1A"
                CornerRadius="12"
                Padding="20,16"
                BorderBrush="#2A2A2A"
                BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="MappingTitle"
                           Grid.Row="0"
                           Text="Mappatura"
                           FontSize="13"
                        FontWeight="SemiBold"
                           Foreground="#888888"/>

                <TextBlock x:Name="EmptyState"
                           Grid.Row="2"
                           Text="Seleziona un tasto per modificare l'azione."
                           FontSize="12"
                           Foreground="#444444"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>

                <Grid x:Name="MappingPanel"
                      Grid.Row="2"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: action type only — no label field -->
                    <StackPanel Grid.Column="0"
                            Spacing="8"
                            VerticalAlignment="Top">
                        <TextBlock Text="Azione"
                                   FontSize="11"
                                Foreground="#666666"/>
                        <ComboBox x:Name="ActionTypeCombo"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="ActionTypeCombo_SelectionChanged">
                            <ComboBoxItem Content="Non assegnato"
                                    Tag="none"/>
                            <ComboBoxItem Content="Controllo multimediale"
                                    Tag="media"/>
                            <ComboBoxItem Content="Apri applicazione"
                                    Tag="app"/>
                            <ComboBoxItem Content="Comando rapido"
                                    Tag="shortcut"/>
                            <ComboBoxItem Content="Apri sito web"
                                    Tag="website"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Right: sub-options -->
                    <Grid Grid.Column="2"
                            VerticalAlignment="Top">

                        <StackPanel x:Name="MediaPanel"
                                Spacing="8"
                                Visibility="Collapsed">
                            <TextBlock Text="Comando"
                                    FontSize="11"
                                    Foreground="#666666"/>
                            <ComboBox x:Name="MediaCombo"
                                    HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Play / Pausa"
                                        Tag="playpause"/>
                                <ComboBoxItem Content="Successivo"
                                        Tag="next"/>
                                <ComboBoxItem Content="Precedente"
                                        Tag="prev"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel x:Name="AppPanel"
                                Spacing="8"
                                Visibility="Collapsed">
                            <TextBlock Text="Applicazione"
                                    FontSize="11"
                                    Foreground="#666666"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="AppPathBox"
                                        Grid.Column="0"
                                         PlaceholderText="Nessuna applicazione selezionata"
                                         IsReadOnly="True"
                                        FontSize="11"/>
                                <Button Grid.Column="1"
                                        Content="Seleziona"
                                        FontSize="11"
                                        Click="SelectApp_Click"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="ShortcutPanel"
                                Spacing="8"
                                Visibility="Collapsed">
                            <TextBlock Text="Combinazione tasti"
                                    FontSize="11"
                                    Foreground="#666666"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ShortcutBox"
                                        Grid.Column="0"
                                         PlaceholderText="Premi Ascolta..."
                                         IsReadOnly="True"
                                        FontSize="11"/>
                                <Button x:Name="ListenButton"
                                        Grid.Column="1"
                                        Content="Ascolta"
                                        FontSize="11"
                                        Click="ListenShortcut_Click"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="WebsitePanel"
                                Spacing="8"
                                Visibility="Collapsed">
                            <TextBlock Text="URL"
                                    FontSize="11"
                                    Foreground="#666666"/>
                            <TextBox x:Name="WebsiteUrlBox"
                                     PlaceholderText="es. youtube.com"
                                     FontSize="12"/>
                        </StackPanel>

                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- ── Bottom buttons ── -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="8">
                <Button Content="Aggiorna firmware"
                        Background="Transparent"
                        BorderBrush="#333333"
                        Foreground="#888888"
                        FontSize="12"
                        Click="UpdateFirmware_Click"/>
                <Button Content="Resetta"
                        Background="Transparent"
                        BorderBrush="#333333"
                        Foreground="#884444"
                        FontSize="12"
                        Click="FactoryReset_Click"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8">
                <Button Content="Cancella"
                        Background="Transparent"
                        BorderBrush="#333333"
                        Foreground="#888888"
                        FontSize="12"
                        Click="Cancel_Click"/>
                <Button Content="Applica"
                        Style="{StaticResource AccentButtonStyle}"
                        FontSize="12"
                        Click="Apply_Click"/>
            </StackPanel>
        </Grid>

    </Grid>
</Page>