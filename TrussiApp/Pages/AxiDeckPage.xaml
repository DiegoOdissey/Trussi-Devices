<?xml version="1.0" encoding="utf-8"?>
<Page
        x:Class="TrussiApp.Pages.AxiDeckPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="Transparent">

        <Grid Padding="32,28,32,28"
                        RowSpacing="16">
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Header -->
                        <RowDefinition Height="Auto"/>
                        <!-- Device layout -->
                        <RowDefinition Height="240"/>
                        <!-- Mapping panel — fixed height -->
                        <RowDefinition Height="Auto"/>
                        <!-- Bottom buttons -->
                </Grid.RowDefinitions>

                <!-- ── Header ── -->
                <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="←"
                                FontSize="16"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#888888"
                                Padding="0"
                                Click="BackButton_Click"/>

                        <TextBlock Grid.Column="2"
                                   Text="AxiDeck"
                                   FontSize="20"
                                        FontWeight="SemiBold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>

                        <Border Grid.Column="3"
                                x:Name="StatusBadge"
                                CornerRadius="14"
                                Background="#2A1A1A"
                                Padding="10,4">
                                <TextBlock x:Name="StatusBadgeText"
                                           Text="Disconnesso"
                                           FontSize="11"
                                           Foreground="#CC3333"/>
                        </Border>
                </Grid>

                <!-- ── Device layout ── -->
                <Border Grid.Row="1"
                        Background="#1A1A1A"
                        CornerRadius="12"
                        Padding="24,20"
                        BorderBrush="#2A2A2A"
                        BorderThickness="1">

                        <Grid RowSpacing="12"
                                        ColumnSpacing="16"
                                        HorizontalAlignment="Center">
                                <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <!-- Buttons row 1 -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- Buttons row 2 -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- Knobs -->
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <!-- Button 1 -->
                                <Button x:Name="Btn1"
                                                Grid.Row="0"
                                                Grid.Column="0"
                                        Tag="BTN:0"
                                        Width="48"
                                                Height="48"
                                        HorizontalAlignment="Center"
                                        Background="#252525"
                                        BorderBrush="#3A3A3A"
                                                BorderThickness="2"
                                        CornerRadius="6"
                                                Padding="0"
                                        Click="InputButton_Click">
                                        <TextBlock x:Name="Btn1Label"
                                                        Text="1"
                                                   FontSize="11"
                                                        Foreground="#666666"/>
                                </Button>

                                <!-- Button 2 -->
                                <Button x:Name="Btn2"
                                                Grid.Row="0"
                                                Grid.Column="1"
                                        Tag="BTN:1"
                                        Width="48"
                                                Height="48"
                                        HorizontalAlignment="Center"
                                        Background="#252525"
                                        BorderBrush="#3A3A3A"
                                                BorderThickness="2"
                                        CornerRadius="6"
                                                Padding="0"
                                        Click="InputButton_Click">
                                        <TextBlock x:Name="Btn2Label"
                                                        Text="2"
                                                   FontSize="11"
                                                        Foreground="#666666"/>
                                </Button>

                                <!-- Button 3 -->
                                <Button x:Name="Btn3"
                                                Grid.Row="0"
                                                Grid.Column="2"
                                        Tag="BTN:2"
                                        Width="48"
                                                Height="48"
                                        HorizontalAlignment="Center"
                                        Background="#252525"
                                        BorderBrush="#3A3A3A"
                                                BorderThickness="2"
                                        CornerRadius="6"
                                                Padding="0"
                                        Click="InputButton_Click">
                                        <TextBlock x:Name="Btn3Label"
                                                        Text="3"
                                                   FontSize="11"
                                                        Foreground="#666666"/>
                                </Button>

                                <!-- Button 4 -->
                                <Button x:Name="Btn4"
                                                Grid.Row="1"
                                                Grid.Column="0"
                                        Tag="BTN:3"
                                        Width="48"
                                                Height="48"
                                        HorizontalAlignment="Center"
                                        Background="#252525"
                                        BorderBrush="#3A3A3A"
                                                BorderThickness="2"
                                        CornerRadius="6"
                                                Padding="0"
                                        Click="InputButton_Click">
                                        <TextBlock x:Name="Btn4Label"
                                                        Text="4"
                                                   FontSize="11"
                                                        Foreground="#666666"/>
                                </Button>

                                <!-- Button 5 -->
                                <Button x:Name="Btn5"
                                                Grid.Row="1"
                                                Grid.Column="1"
                                        Tag="BTN:4"
                                        Width="48"
                                                Height="48"
                                        HorizontalAlignment="Center"
                                        Background="#252525"
                                        BorderBrush="#3A3A3A"
                                                BorderThickness="2"
                                        CornerRadius="6"
                                                Padding="0"
                                        Click="InputButton_Click">
                                        <TextBlock x:Name="Btn5Label"
                                                        Text="5"
                                                   FontSize="11"
                                                        Foreground="#666666"/>
                                </Button>

                                <!-- Button 6 -->
                                <Button x:Name="Btn6"
                                                Grid.Row="1"
                                                Grid.Column="2"
                                        Tag="BTN:5"
                                        Width="48"
                                                Height="48"
                                        HorizontalAlignment="Center"
                                        Background="#252525"
                                        BorderBrush="#3A3A3A"
                                                BorderThickness="2"
                                        CornerRadius="6"
                                                Padding="0"
                                        Click="InputButton_Click">
                                        <TextBlock x:Name="Btn6Label"
                                                        Text="6"
                                                   FontSize="11"
                                                        Foreground="#666666"/>
                                </Button>

                                <!-- Knob 1 -->
                                <Button x:Name="Knob1Btn"
                                                Grid.Row="2"
                                                Grid.Column="0"
                                        Tag="KNOB:0"
                                        Width="52"
                                                Height="52"
                                        HorizontalAlignment="Center"
                                        Background="#252525"
                                        BorderBrush="#3A3A3A"
                                                BorderThickness="2"
                                        CornerRadius="26"
                                                Padding="0"
                                        Click="InputButton_Click"
                                        Margin="25,0,0,0">
                                        <TextBlock Text="K1"
                                                        FontSize="11"
                                                        Foreground="#666666"/>
                                </Button>

                                <!-- Knob 2 -->
                                <Button x:Name="Knob2Btn"
                                                Grid.Row="2"
                                                Grid.Column="2"
                                        Tag="KNOB:1"
                                        Width="52"
                                                Height="52"
                                        HorizontalAlignment="Center"
                                        Background="#252525"
                                        BorderBrush="#3A3A3A"
                                                BorderThickness="2"
                                        CornerRadius="26"
                                                Padding="0"
                                        Click="InputButton_Click"
                                        Margin="0,0,25,0">
                                        <TextBlock Text="K2"
                                                        FontSize="11"
                                                        Foreground="#666666"/>
                                </Button>
                        </Grid>
                </Border>

                <!-- ── Mapping panel — fixed height, content swaps ── -->
                <Border Grid.Row="2"
                        Background="#1A1A1A"
                        CornerRadius="12"
                        Padding="20,16"
                        BorderBrush="#2A2A2A"
                        BorderThickness="1">

                        <Grid>
                                <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <!-- Title -->
                                        <RowDefinition Height="12"/>
                                        <!-- Spacer -->
                                        <RowDefinition Height="*"/>
                                        <!-- Content -->
                                </Grid.RowDefinitions>

                                <!-- Title -->
                                <TextBlock x:Name="MappingTitle"
                                           Grid.Row="0"
                                           Text="Mappatura"
                                           FontSize="13"
                                                FontWeight="SemiBold"
                                           Foreground="#888888"/>

                                <!-- ── Empty state ── -->
                                <TextBlock x:Name="EmptyState"
                                           Grid.Row="2"
                                           Text="Seleziona un tasto o un knob per modificare l'azione."
                                           FontSize="12"
                                           Foreground="#444444"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>

                                <!-- ── Active mapping panel ── -->
                                <Grid x:Name="MappingPanel"
                                      Grid.Row="2"
                                      Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: label + action type -->
                                        <StackPanel Grid.Column="0"
                                                    Spacing="8"
                                                    VerticalAlignment="Top">

                                                <!-- Label sent to Arduino -->
                                                <TextBlock Text="Etichetta deck"
                                                           FontSize="11"
                                                           Foreground="#666666"/>
                                                <TextBox x:Name="LabelBox"
                                                         PlaceholderText="Max 8 caratteri"
                                                         MaxLength="8"
                                                         FontSize="12"/>

                                                <Border Height="8"/>

                                                <TextBlock Text="Azione"
                                                           FontSize="11"
                                                           Foreground="#666666"/>
                                                <ComboBox x:Name="ActionTypeCombo"
                                                          HorizontalAlignment="Stretch"
                                                          SelectionChanged="ActionTypeCombo_SelectionChanged">
                                                        <ComboBoxItem Content="Non assegnato"    Tag="none"/>
                                                        <ComboBoxItem Content="Controllo multimediale" Tag="media"/>
                                                        <ComboBoxItem Content="Apri applicazione" Tag="app"/>
                                                        <ComboBoxItem Content="Comando rapido"   Tag="shortcut"/>
                                                        <ComboBoxItem Content="Apri sito web"
                                                                        Tag="website"/>
                                                        <ComboBoxItem x:Name="VolumeOption"
                                                                      Content="Controllo volume" Tag="volume"/>
                                                </ComboBox>
                                        </StackPanel>

                                        <!-- Right: sub-options -->
                                        <Grid Grid.Column="2"
                                              VerticalAlignment="Top">

                                                <!-- Media sub-options -->
                                                <StackPanel x:Name="MediaPanel"
                                                                Spacing="8"
                                                            Visibility="Collapsed">
                                                        <TextBlock Text="Comando"
                                                                   FontSize="11"
                                                                        Foreground="#666666"/>
                                                        <ComboBox x:Name="MediaCombo"
                                                                  HorizontalAlignment="Stretch">
                                                                <ComboBoxItem Content="Play / Pausa"
                                                                                Tag="playpause"/>
                                                                <ComboBoxItem Content="Successivo"
                                                                                Tag="next"/>
                                                                <ComboBoxItem Content="Precedente"
                                                                                Tag="prev"/>
                                                        </ComboBox>
                                                </StackPanel>

                                                <!-- App launcher sub-options -->
                                                <StackPanel x:Name="AppPanel"
                                                                Spacing="8"
                                                            Visibility="Collapsed">
                                                        <TextBlock Text="Applicazione"
                                                                   FontSize="11"
                                                                        Foreground="#666666"/>
                                                        <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox x:Name="AppPathBox"
                                                                         Grid.Column="0"
                                                                         PlaceholderText="Nessuna applicazione selezionata"
                                                                         IsReadOnly="True"
                                                                         FontSize="11"/>
                                                                <Button Grid.Column="1"
                                                                        Content="Seleziona"
                                                                        FontSize="11"
                                                                        Click="SelectApp_Click"/>
                                                        </Grid>
                                                </StackPanel>

                                                <!-- Website sub-options -->
                                                <StackPanel x:Name="WebsitePanel"
                                                            Spacing="8"
                                                            Visibility="Collapsed">
                                                        <TextBlock Text="URL"
                                                                   FontSize="11"
                                                                   Foreground="#666666"/>
                                                        <TextBox x:Name="WebsiteUrlBox"
                                                                 PlaceholderText="es. youtube.com"
                                                                 FontSize="12"/>
                                                </StackPanel>

                                                <!-- Shortcut sub-options -->
                                                <StackPanel x:Name="ShortcutPanel"
                                                                Spacing="8"
                                                            Visibility="Collapsed">
                                                        <TextBlock Text="Combinazione tasti"
                                                                   FontSize="11"
                                                                        Foreground="#666666"/>
                                                        <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox x:Name="ShortcutBox"
                                                                         Grid.Column="0"
                                                                         PlaceholderText="Premi Ascolta..."
                                                                         IsReadOnly="True"
                                                                         FontSize="11"/>
                                                                <Button x:Name="ListenButton"
                                                                        Grid.Column="1"
                                                                        Content="Ascolta"
                                                                        FontSize="11"
                                                                        Click="ListenShortcut_Click"/>
                                                        </Grid>
                                                </StackPanel>

                                                <!-- Volume sub-options -->
                                                <StackPanel x:Name="VolumePanel"
                                                                Spacing="8"
                                                            Visibility="Collapsed">
                                                        <TextBlock Text="Tipo di volume"
                                                                   FontSize="11"
                                                                        Foreground="#666666"/>
                                                        <ComboBox x:Name="VolumeTypeCombo"
                                                                  HorizontalAlignment="Stretch"
                                                                  SelectionChanged="VolumeTypeCombo_SelectionChanged">
                                                                <ComboBoxItem Content="Volume generale"
                                                                                Tag="master"/>
                                                                <ComboBoxItem Content="Volume applicazione"
                                                                                Tag="app"/>
                                                        </ComboBox>

                                                        <!-- Populated dynamically from active audio sessions -->
                                                        <ComboBox x:Name="VolumeAppCombo"
                                                                  HorizontalAlignment="Stretch"
                                                                  PlaceholderText="Seleziona processo..."
                                                                  Visibility="Collapsed"/>
                                                </StackPanel>

                                        </Grid>
                                </Grid>

                        </Grid>
                </Border>

                <!-- ── Bottom buttons ── -->

                <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        Margin="0,8,0,0">
                                <Button Content="Aggiorna firmware"
                                        Background="Transparent"
                                        BorderBrush="#333333"
                                        Foreground="#888888"
                                        FontSize="12"
                                        Click="UpdateFirmware_Click"/>
                                <Button Content="Resetta"
                                        Background="Transparent"
                                        BorderBrush="#333333"
                                        Foreground="#884444"
                                        FontSize="12"
                                        Click="FactoryReset_Click"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        Margin="0,8,0,0">
                                <Button Content="Cancella"
                                        Background="Transparent"
                                        BorderBrush="#333333"
                                        Foreground="#888888"
                                        FontSize="12"
                                        Click="Cancel_Click"/>
                                <Button Content="Applica"
                                        Style="{StaticResource AccentButtonStyle}"
                                        FontSize="12"
                                        Click="Apply_Click"/>
                        </StackPanel>
                </Grid>

        </Grid>
</Page>