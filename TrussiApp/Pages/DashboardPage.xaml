<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TrussiApp.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Padding="36,32,36,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Page title -->
            <RowDefinition Height="24"/>
            <!-- Spacer -->
            <RowDefinition Height="*"/>
            <!-- Cards -->
        </Grid.RowDefinitions>

        <!-- ── Page title ── -->
        <TextBlock Grid.Row="0"
                   Text="Dispositivi"
                   FontSize="20"
                FontWeight="SemiBold"
                   Foreground="White"/>

        <!-- ── Device cards ── -->
        <ItemsControl Grid.Row="2"
                x:Name="DeviceGrid">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <!-- AxiDeck card -->
            <Button x:Name="AxiDeckCard"
                    Width="220"
                    Height="280"
                    Padding="0"
                    Background="#1E1E1E"
                    BorderThickness="1"
                    BorderBrush="#2A2A2A"
                    CornerRadius="12"
                    Margin="0,0,16,16"
                    Click="AxiDeckCard_Click">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <!-- Thumbnail -->
                        <RowDefinition Height="Auto"/>
                        <!-- Name + dot -->
                    </Grid.RowDefinitions>

                    <!-- Thumbnail area -->
                    <Border Grid.Row="0"
                            CornerRadius="12,12,0,0"
                            Background="#252525"
                            Margin="0">

                        <Image x:Name="AxiDeckThumb"
                               Source="ms-appx:///Assets/AxiDeck.png"
                               Stretch="Uniform"
                               Margin="0"/>

                    </Border>

                    <!-- Name + status dot -->
                    <Grid Grid.Row="1"
                          Padding="14,10,14,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="AxiDeck"
                                   FontSize="14"
                                FontWeight="SemiBold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>

                        <Ellipse x:Name="AxiDeckDot"
                                 Grid.Column="1"
                                 Width="8"
                                Height="8"
                                 Fill="#CC3333"
                                 VerticalAlignment="Center"/>
                    </Grid>

                </Grid>
            </Button>

            <!-- TrussiRing card -->
            <Button x:Name="TrussiRingCard"
                    Width="160"
                    Height="200"
                    Padding="0"
                    Background="#1E1E1E"
                    BorderThickness="1"
                    BorderBrush="#2A2A2A"
                    CornerRadius="12"
                    Margin="0,0,16,16"
                    Click="TrussiRingCard_Click">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            CornerRadius="12,12,0,0"
                            Background="#252525">
                        <Image x:Name="TrussiRingThumb"
                               Source="ms-appx:///Assets/TrussiRing.png"
                               Stretch="Uniform"
                               Margin="20"/>
                    </Border>

                    <Grid Grid.Row="1"
                            Padding="14,10,14,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="TrussiRing"
                                   FontSize="13"
                                FontWeight="SemiBold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>

                        <Ellipse x:Name="TrussiRingDot"
                                 Grid.Column="1"
                                 Width="8"
                                Height="8"
                                 Fill="#CC3333"
                                 VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Button>

            <!-- Coming soon card -->
            <Border Width="200"
                    Height="250"
                    Background="#2A2A2A"
                    BorderThickness="1"
                    BorderBrush="#444444"
                    CornerRadius="12"
                    Margin="0,0,16,16"
                    Opacity="0.85">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            CornerRadius="12,12,0,0"
                            Background="#333333"
                            Margin="0">
                        <FontIcon Glyph="&#xE710;"
                                  FontSize="28"
                                  Foreground="#888888"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>

                    <Grid Grid.Row="1"
                          Padding="14,12,14,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Prossimo dispositivo"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#DDDDDD"
                                   Margin="0,0,0,2"/>

                        <TextBlock Grid.Row="1"
                                   Text="In arrivo"
                                   FontSize="11"
                                   Foreground="#AAAAAA"/>
                    </Grid>
                </Grid>
            </Border>
        </ItemsControl>
    </Grid>
</Page>